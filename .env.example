# ==============================================================================
# BhaktiMania Environment Configuration Template
# ==============================================================================
# For local development, copy this template to .env.local:
# cp .env.example .env.local
#
# For production deployment (e.g. Vercel), configure these variables
# in your project environment settings.
# ==============================================================================

# 1. Public Site Base URL (e.g. https://bhaktimania.com in production, http://localhost:3000 in development)
NEXT_PUBLIC_SITE_URL=

# 2. Supabase Project Connection
# Obtain from: Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 3. Google Search Console Verification (Optional)
# Supply the verification token from Google Search Console when verifying your domain
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# 4. Google AdSense Configuration (Phase M2 — Disabled by default)
# Set your real AdSense publisher ID when approved (e.g. ca-pub-XXXXXXXXXXXXXXXX)
# Keep disabled (false) until officially approved.
NEXT_PUBLIC_ADSENSE_PUBLISHER_ID=
NEXT_PUBLIC_ADSENSE_ENABLED=false
